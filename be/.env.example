PORT=8000

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PWD=

# Auth secret (recommended)
JWT_SECRET=replace_with_a_long_random_secret

# Optional legacy fallback if JWT_SECRET is missing
API_KEY=replace_with_a_long_random_secret

# Comma-separated allowlist for CORS + Socket.IO (no trailing slash)
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# Set true to include reset token in API response (development only)
RESET_DEBUG_TOKEN=false
